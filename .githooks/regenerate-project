#!/bin/sh
# Regenerate ReadBTR.xcodeproj after git changes the working tree, so the
# generated (uncommitted) project never misses newly added source files.
# Enabled with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if command -v xcodegen >/dev/null 2>&1; then
  xcodegen generate --quiet || echo "warning: xcodegen generate failed" >&2
else
  echo "warning: xcodegen not installed; run 'xcodegen generate' manually" >&2
fi
exit 0
